; Maré de Vidro — projeto Godot 4.3 (renderizador Compatibility: roda em
; qualquer GPU com OpenGL 3.3, inclusive notebooks antigos).

config_version=5

[application]

config/name="Maré de Vidro"
config/description="Aventura 3D de exploração e puzzles de maré num arquipélago suspenso."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0627451, 0.137255, 0.192157, 1)
boot_splash/show_image=false

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=14.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.0627451, 0.137255, 0.192157, 1)
