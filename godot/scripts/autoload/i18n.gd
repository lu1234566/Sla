func set_language(l: String) -> void:
	if l != lang and (l == "pt" or l == "en"):
		lang = l
		TranslationServer.set_locale("pt_BR" if l == "pt" else "en")
		language_changed.emit()

func has(key: String) -> bool:
	return PT.has(key)

func t(key: String, params: Dictionary = {}) -> String:
	var table: Dictionary = PT if lang == "pt" else EN
	var s: String = table.get(key, PT.get(key, key))
	for k in params:
		s = s.replace("{%s}" % k, str(params[k]))
	if s.find("{") >= 0:
		for a in ["jump", "interact", "tide", "scan", "dodge"]:
			s = s.replace("{%s}" % a, key_name(a))
	return s

## Nome da tecla atual de uma ação (respeita remapeamento e controle).
func key_name(action: String) -> String:
	if pad_prompts:
		return (PT if lang == "pt" else EN).get("pad." + action, action)
	for ev in InputMap.action_get_events(action):
		if ev is InputEventKey:
			var code: int = ev.physical_keycode if ev.physical_keycode != 0 else ev.keycode
			if code == KEY_SPACE:
				return (PT if lang == "pt" else EN)["key.jump"]
			return OS.get_keycode_string(code)
	return (PT if lang == "pt" else EN).get("key." + action, action)
